# PulseGo configuration. Copy to .env and adjust; .env is git-ignored.
# Every variable is validated at startup — an invalid value stops the process
# with an explicit message rather than failing later at first use.

# --- Identity ---------------------------------------------------------------
# Used as the `service` field on every log record.
SERVICE_NAME=pulsego
# development | staging | production
ENVIRONMENT=development
# debug | info | warn | error
LOG_LEVEL=info

# --- HTTP -------------------------------------------------------------------
# Public API. Must differ from INTERNAL_HTTP_ADDR.
HTTP_ADDR=:8080
# Operator endpoints (health, and /metrics from Sprint 5). Do not expose this
# port publicly.
INTERNAL_HTTP_ADDR=:9090

# --- Database ---------------------------------------------------------------
# Required. Must use the postgres:// or postgresql:// scheme.
DATABASE_URL=postgres://pulsego:pulsego@localhost:5432/pulsego?sslmode=disable

# --- Integration tests -----------------------------------------------------
# Not read by the application. When set, `make test-integration` uses this
# PostgreSQL server instead of Testcontainers and creates and drops its own
# pulsego_test_* databases on it (the role needs CREATEDB).
# PULSEGO_TEST_DATABASE_URL=postgres://pulsego:pulsego@localhost:5432/postgres?sslmode=disable

# --- Authentication ---------------------------------------------------------
# Required, at least 16 characters. Guards /v1/*; health endpoints stay open.
# Never commit a real key — generate one with: openssl rand -hex 32
API_KEY=local-development-api-key

# --- Worker -----------------------------------------------------------------
# Maximum checks running at once in a single worker process (1-256).
WORKER_CONCURRENCY=10
# Monitors claimed per poll (1-500).
WORKER_BATCH_SIZE=20
# How often a worker looks for due monitors (1s-5m).
WORKER_POLL_INTERVAL=5s
# How long a claim is held. Must exceed DEFAULT_CHECK_TIMEOUT, otherwise a
# second worker could reclaim a monitor while the first is still checking it.
WORKER_LEASE_DURATION=60s

# --- Check defaults ---------------------------------------------------------
# Applied to new monitors that do not specify their own values.
DEFAULT_CHECK_INTERVAL=60s
DEFAULT_CHECK_TIMEOUT=5s
# Days of monitor_checks history to retain (1-365).
CHECK_RETENTION_DAYS=30

# --- Safety -----------------------------------------------------------------
# DEVELOPMENT ONLY. When true, monitors may target loopback and private
# addresses, which turns the checker into an SSRF gadget against your own
# network. Loading the config refuses this outside ENVIRONMENT=development.
ALLOW_PRIVATE_TARGETS=false

# --- Telemetry --------------------------------------------------------------
# Tracing is optional; with OTEL_ENABLED=false the app starts normally and
# exports nothing. When true, the endpoint below is required: the OTLP/HTTP
# base URL of a collector (http:// or https:// with a host), for example
# http://localhost:4318 — PulseGo appends /v1/traces. An unreachable collector
# never blocks startup; export errors are logged as warnings.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Lifecycle --------------------------------------------------------------
# Budget for draining in-flight work after SIGTERM/SIGINT (1s-2m).
SHUTDOWN_TIMEOUT=15s
